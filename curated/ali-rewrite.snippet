^https?:\/\/(?:guide-)?acs\.m\.taobao\.com\/(?:gw|h5)\/mtop\.taobao\.wireless\.home\.splash\.awesome\.get\/1\.0\/?(?:\?[^#]*)?$ url script-response-body app-adblock.js
