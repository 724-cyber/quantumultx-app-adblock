^https?:\/\/(?:(?:g-)?acs\.m\.goofish\.com|(?:channel-)?acs\.m\.taobao\.com)\/(?:gw|h5)\/(?:mtop\.taobao\.idlehome\.home\.nextfresh|mtop\.taobao\.wireless\.home\.xianyu\.awesome\.get|mtop\.taobao\.idle\.home\.(?:myattention|moore\.section)|mtop\.taobao\.idle\.local\.(?:home(?:\.(?:top|feeds))?|flow\.plat\.section))\/\d+(?:\.\d+)*\/?(?:\?[^#]*)?$ url script-response-body app-adblock.js
