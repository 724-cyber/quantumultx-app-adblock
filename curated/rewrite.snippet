#!name=自有 App 去广告与遥测
#!desc=闲鱼、淘宝、抖音静态适配；iOS待实测。固定哈希脚本，不运行上游JS。
hostname = acs.m.goofish.com, g-acs.m.goofish.com, acs.m.taobao.com, channel-acs.m.taobao.com, guide-acs.m.taobao.com, aweme.snssdk.com, log.zijieapi.com, applog.zijieapi.com, rtlog.zijieapi.com, log.snssdk.com, rtlog.snssdk.com, rtapplog.snssdk.com, mon.snssdk.com, mon.zijieapi.com

^https?:\/\/(?:(?:g-)?acs\.m\.goofish\.com|(?:channel-)?acs\.m\.taobao\.com)\/(?:gw|h5)\/mtop\.taobao\.idlecommerce\.splash\.(?:async\.)?ads\/\d+(?:\.\d+)*\/?(?:\?[^#]*)?$ url script-response-body app-adblock.js
^https?:\/\/(?:(?:g-)?acs\.m\.goofish\.com|(?:channel-)?acs\.m\.taobao\.com)\/(?:gw|h5)\/(?:mtop\.taobao\.idlehome\.home\.nextfresh|mtop\.taobao\.wireless\.home\.xianyu\.awesome\.get|mtop\.taobao\.idle\.home\.(?:myattention|moore\.section)|mtop\.taobao\.idle\.local\.(?:home(?:\.(?:top|feeds))?|flow\.plat\.section))\/\d+(?:\.\d+)*\/?(?:\?[^#]*)?$ url script-response-body app-adblock.js
^https?:\/\/(?:(?:g-)?acs\.m\.goofish\.com|(?:channel-)?acs\.m\.taobao\.com)\/(?:gw|h5)\/mtop\.idle\.ad\.(?:click|expose|failed\.batch\.(?:click|expose))\/1\.0\/?(?:\?[^#]*)?$ url script-echo-response app-adblock.js
^https?:\/\/(?:guide-)?acs\.m\.taobao\.com\/(?:gw|h5)\/mtop\.taobao\.wireless\.home\.splash\.awesome\.get\/1\.0\/?(?:\?[^#]*)?$ url script-response-body app-adblock.js
^https?:\/\/(?:guide-)?acs\.m\.taobao\.com\/(?:gw|h5)\/(?:mtop\.taobao\.wsearch\.appsearch|mtop\.relationrecommend\.[Mm]top[Rr]ecommend\.recommend)\/1\.0\/?(?:\?[^#]*)?$ url script-response-body app-adblock.js
^https:\/\/aweme\.snssdk\.com(?::443)?\/aweme\/(?:v1\/feed|v2\/(?:preview\/)?feed)\/(?:\?[^#]*)?$ url script-response-body app-adblock.js
^https:\/\/aweme\.snssdk\.com(?::443)?\/api\/ad\/splash\/[a-zA-Z0-9_-]{1,40}\/v14\/(?:\?[^#]*)?$ url script-response-body app-adblock.js
^https:\/\/aweme\.snssdk\.com(?::443)?\/api\/ad\/splash\/realtime\/aweme\/v14\/(?:\?[^#]*)?$ url script-response-body app-adblock.js
^https:\/\/(?:log|applog|rtlog)\.zijieapi\.com\/service\/2\/app_log\/?(?:\?[^#]*)?$ url reject
^https:\/\/(?:log|rtlog|rtapplog)\.snssdk\.com\/service\/2\/app_log\/?(?:\?[^#]*)?$ url reject
^https:\/\/log\.zijieapi\.com\/service\/2\/app_log_monitor\/?(?:\?[^#]*)?$ url reject
